\@writefile{toc}{\contentsline {section}{\numberline {4}Results}{3}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Question 1: metabolic-gene-only clustering}{3}{subsection.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Global metabolic-gene PCA. Left: six-cluster partition selected after the 5\% minimum-cluster rule. Right: the same PCA coordinates colored post hoc by 3CA cell type. Annotation was not used to construct the PCA or clusters. The visual overlap and gradients argue against sharply separated universal states.}}{4}{figure.caption.3}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:global-embedding}{{1}{4}{Global metabolic-gene PCA. Left: six-cluster partition selected after the 5\% minimum-cluster rule. Right: the same PCA coordinates colored post hoc by 3CA cell type. Annotation was not used to construct the PCA or clusters. The visual overlap and gradients argue against sharply separated universal states}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Global evidence checks. Left: prespecified $k$ sweep; crosses fail the 5\% minimum-cluster rule, explaining why $k=6$ is reported instead of the higher-scoring but degenerate $k=5$. Middle: all 19 matched random non-metabolic gene sets exceed the metabolic control score. Right: post hoc cell-type composition of the six clusters.}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:global-evidence}{{2}{4}{Global evidence checks. Left: prespecified $k$ sweep; crosses fail the 5\% minimum-cluster rule, explaining why $k=6$ is reported instead of the higher-scoring but degenerate $k=5$. Middle: all 19 matched random non-metabolic gene sets exceed the metabolic control score. Right: post hoc cell-type composition of the six clusters}{figure.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Question 2: association with cell type}{4}{subsection.4.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Post hoc association metrics. Similar patient, sample, and cell-type values prevent a clean cell-type-specific metabolic interpretation.}}{5}{table.caption.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Descriptive global signatures. Values are row-wise $z$-scores of cluster mean $\log (1+x)$ expression for representative enriched metabolic genes. The heatmap is intended for labeling candidate patterns, not for inferential differential-expression claims.}}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig:global-signatures}{{3}{5}{Descriptive global signatures. Values are row-wise $z$-scores of cluster mean $\log (1+x)$ expression for representative enriched metabolic genes. The heatmap is intended for labeling candidate patterns, not for inferential differential-expression claims}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Question 3: heterogeneity within CD8 T cells}{6}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces CD8 diagnostic PCA. The apparent split is a small, distant group of 54 cells rather than two broadly represented populations. Both panels contain only cells annotated by 3CA as CD8 T cells.}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:cd8-embedding}{{4}{6}{CD8 diagnostic PCA. The apparent split is a small, distant group of 54 cells rather than two broadly represented populations. Both panels contain only cells annotated by 3CA as CD8 T cells}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces CD8 evidence checks. Left: every tested $k$ fails the 5\% size rule. Middle: exploratory matched-gene control; the red line is the metabolic score. Right: patient composition, showing that 45 of 54 rare-group cells are from patient 1.}}{6}{figure.caption.8}\protected@file@percent }
\newlabel{fig:cd8-evidence}{{5}{6}{CD8 evidence checks. Left: every tested $k$ fails the 5\% size rule. Middle: exploratory matched-gene control; the red line is the metabolic score. Right: patient composition, showing that 45 of 54 rare-group cells are from patient 1}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Diagnostic CD8 signatures. The two-column heatmap necessarily accentuates the contrast and should not be read as evidence that the 54-cell group is a general CD8 state.}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:cd8-signatures}{{6}{7}{Diagnostic CD8 signatures. The two-column heatmap necessarily accentuates the contrast and should not be read as evidence that the 54-cell group is a general CD8 state}{figure.caption.9}{}}
