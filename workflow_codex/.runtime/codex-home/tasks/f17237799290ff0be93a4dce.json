iles\\\\MiKTeX\\\\tex/latex/amsfonts\\\\amsfonts.sty))\\n(C:\\\\Users\\\\User\\\\AppData\\\\Roaming\\\\MiKTeX\\\\tex/latex/geometry\\\\geometry.sty\\n(C:\\\\Program Files\\\\MiKTeX\\\\tex/generic/iftex\\\\ifvtex.sty\\n(C:\\\\Program Files\\\\MiKTeX\\\\tex/generic/iftex\\\\iftex.sty))\\n(C:\\\\Users\\\\User\\\\AppData\\\\Roaming\\\\MiKTeX\\\\tex/latex/geometry\\\\geometry.cfg))\\n(C:\\\\Users\\\\User\\\\AppData\\\\Roaming\\\\MiKTeX\\\\tex/latex/caption\\\\caption.sty\\n(C:\\\\Users\\\\User\\\\AppData\\\\Roaming\\\\MiKTeX\\\\tex/latex/caption\\\\caption3.sty))\\n(C:\\\\Users\\\\User\\\\AppData\\\\Roaming\\\\MiKTeX\\\\tex/latex/caption\\\\subcaption.sty)\\n(C:\\\\Program Files\\\\MiKTeX\\\\tex/latex/l3backend\\\\l3backend-pdftex.def) (main.aux)\\n(C:\\\\Program Files\\\\MiKTeX\\\\tex/context/base/mkii\\\\supp-pdf.mkii\\n[Loading MPS to PDF converter (version 2006.09.02).]\\n) (C:\\\\Program Files\\\\MiKTeX\\\\tex/latex/epstopdf-pkg\\\\epstopdf-base.sty\\n(C:\\\\Program Files\\\\MiKTeX\\\\tex/latex/00miktex\\\\epstopdf-sys.cfg))\\n*geometry* driver: auto-detecting\\n*geometry* detected driver: pdftex\\n(C:\\\\Program Files\\\\MiKTeX\\\\tex/latex/amsfonts\\\\umsa.fd)\\n(C:\\\\Program Files\\\\MiKTeX\\\\tex/latex/amsfonts\\\\umsb.fd) [1{C:/Users/User/AppData/L\\nocal/MiKTeX/fonts/map/pdftex/pdftex.map}]\\n\\nLaTeX Warning: File `figures/metabolic_umap.pdf' not found on input line 47.\\n\\n\\nmain.tex:47: Package pdftex.def Error: File `figures/metabolic_umap.pdf' not fo\\nund: using draft setting.\\n\\nSee the pdftex.def package documentation for explanation.\\nType  H <return>  for immediate help.\\n ...                                              \\n                                                  \\nl.47 ...th=\\\\textwidth]{figures/metabolic_umap.pdf}\\n                                                  \\nmain.tex:47:  ==> Fatal error occurred, no output PDF file produced!\\nTranscript written on main.log.\\n\\npdflatex: major issue: So far, you have not checked for